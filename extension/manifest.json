{
  "manifest_version": 3,
  "name": "Privacy Preserving Browser Agent",
  "version": "0.1.0",
  "description": "Local privacy firewall for AI browser agents.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "result.html",
        "result.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
